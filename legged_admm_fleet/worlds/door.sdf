      <material><ambient>0.7 0.2 0.2 1</ambient><diffuse>0.8 0.2 0.2 1</diffuse></material></visual></link></model>
    <model name="wall_0"><static>true</static>
      <pose>8.4 4.375 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.21 5.25 1.0</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.21 5.25 1.0</size></box></geometry>
      <material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.4 0.4 0.45 1</diffuse></material></visual></link></model>
    <model name="wall_1"><static>true</static>
      <pose>8.4 -4.375 0.5 0 0 0</pose>
