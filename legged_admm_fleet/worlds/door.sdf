      <material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.4 0.4 0.45 1</diffuse></material></visual></link></model>
    <model name="wall_2"><static>true</static>
      <pose>14.0 0.0 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.21 14.0 1.0</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.21 14.0 1.0</size></box></geometry>
      <material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.4 0.4 0.45 1</diffuse></material></visual></link></model>
    <model name="wall_3"><static>true</static>
      <pose>11.2 7.0 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>5.6 0.21 1.0</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>5.6 0.21 1.0</size></box></geometry>
      <material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.4 0.4 0.45 1</diffuse></material></visual></link></model>
    <model name="wall_4"><static>true</static>
      <pose>11.2 -7.0 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>5.6 0.21 1.0</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>5.6 0.21 1.0</size></box></geometry>
      <material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.4 0.4 0.45 1</diffuse></material></visual></link></model>
    <!-- overhead camera for headless demo recording (renders via gz-sim-sensors-system, ogre2) -->
    <model name="arena_cam"><static>true</static>
      <pose>7.0 -10 13 0 0.85 1.5708</pose>
      <link name="link">
        <sensor name="arena_cam" type="camera">
          <camera>
            <horizontal_fov>1.1</horizontal_fov>
            <image><width>1280</width><height>720</height></image>
            <clip><near>0.1</near><far>200</far></clip>
          </camera>
          <always_on>1</always_on><update_rate>30</update_rate>
          <topic>arena_cam/image</topic>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
